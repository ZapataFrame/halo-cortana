# El visor funciona aunque el proveedor no esté disponible.
HOST=0.0.0.0
PORT=3000
# Conversación: cada persona configura su propia clave y acceso/cuota.
LLM_PROVIDER=gemini
OLLAMA_CLOUD_MODEL=gemma4:31b
OLLAMA_API_KEY=
# Para GPT: LLM_PROVIDER=openai. Se conserva disponible en el selector.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# También puedes elegir Local / Ollama y tu Qwen instalado desde /control.
# Para arrancar siempre en local: LLM_PROVIDER=ollama y el nombre exacto de ollama list.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:32b
# Clave y facturación API propias, separadas de ChatGPT/Codex.

# Gemini API: LLM_PROVIDER=gemini para usarlo al arrancar; también seleccionable en el control.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Voz local: piper o rvc (Piper seguido del modelo Cortana RVC v2).
TTS_PROVIDER=rvc
# Vacías: utiliza la voz descargada con npm run setup:demo o setup:cortana.
# Para otra ubicación, usa rutas absolutas del PC; nunca dentro de public/.
RVC_MODEL_PATH=
RVC_INDEX_PATH=
