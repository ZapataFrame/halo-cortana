{
  "name": "cortana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "npm run build && npm start",
    "test": "node --test tests/*.test.js",
    "qa:visual": "node tools/serve-visual-qa.mjs",
    "setup:voice": "node tools/setup-voice.mjs",
    "setup:stt": "node tools/setup-stt.mjs",
    "animations:bake": "node tools/bake-cortana-motion.mjs",
    "setup:cortana": "node tools/setup-cortana.mjs",
    "setup:demo": "node tools/setup-demo.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.3"
  }
}
